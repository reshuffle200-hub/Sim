<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Unit 1 — Westinghouse 3-Loop PWR — Overview</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0d1117; --surface:#151b23; --surface2:#1c242e; --line:#242d38;
  --ink:#e6edf3; --dim:#8b98a5; --dim2:#5e6b7a;
  --accent:#4a9eff; --good:#3fb950; --warn:#d29922; --bad:#f85149;
  --violet:#a371f7; --teal:#39c5cf;
  --mono:'JetBrains Mono',ui-monospace,monospace;
  --sans:'Inter',system-ui,sans-serif;
  --r:10px;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:14px;
  padding:16px;min-height:100vh;-webkit-font-smoothing:antialiased}
.wrap{max-width:1560px;margin:0 auto;display:flex;flex-direction:column;gap:12px}

.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r)}
.card h2{font-size:11px;font-weight:600;letter-spacing:.09em;text-transform:uppercase;
  color:var(--dim);margin:0;padding:13px 16px 0}

/* header */
header{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:stretch}
.title{padding:16px 20px}
.title h1{margin:0;font-size:20px;font-weight:600;letter-spacing:-.01em}
.title p{margin:5px 0 0;color:var(--dim);font-size:12.5px}
.kpis{display:flex;gap:1px;background:var(--line);border-radius:var(--r);overflow:hidden}
.kpi{background:var(--surface);padding:14px 20px;min-width:120px;text-align:right}
.kpi .l{font-size:10.5px;font-weight:500;letter-spacing:.07em;text-transform:uppercase;color:var(--dim)}
.kpi .v{font-family:var(--mono);font-size:25px;font-weight:600;line-height:1.15;margin-top:3px;
  font-variant-numeric:tabular-nums}
.kpi .u{font-size:10.5px;color:var(--dim2);font-family:var(--mono)}

/* trip banner */
#banner{display:none;padding:12px 18px;border-radius:var(--r);
  background:rgba(248,81,73,.12);border:1px solid rgba(248,81,73,.4);
  color:var(--bad);font-weight:600;font-size:14px;letter-spacing:.01em}
#banner.on{display:block}
#banner span{color:var(--ink);font-weight:400;margin-left:10px}

/* grid */
.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
@media(max-width:1280px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:720px){.grid{grid-template-columns:1fr}}
.rows{padding:6px 16px 14px}
.row{display:flex;justify-content:space-between;align-items:baseline;padding:6px 0;
  border-bottom:1px solid rgba(255,255,255,.04);gap:12px}
.row:last-child{border-bottom:0}
.row .k{color:var(--dim);font-size:12.5px}
.row .v{font-family:var(--mono);font-size:13.5px;font-variant-numeric:tabular-nums;text-align:right}
.v.good{color:var(--good)} .v.warn{color:var(--warn)} .v.bad{color:var(--bad)}
.v.dimv{color:var(--dim2)}

/* bar */
.bar{height:5px;background:#0b1017;border-radius:3px;overflow:hidden;margin-top:7px}
.bar i{display:block;height:100%;background:var(--accent);border-radius:3px;transition:width .18s}
.bar i.good{background:var(--good)} .bar i.warn{background:var(--warn)} .bar i.bad{background:var(--bad)}

/* loops / SGs as mini columns */
.mini{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;padding:8px 16px 14px}
.m{background:var(--surface2);border-radius:7px;padding:9px 10px}
.m .t{font-size:10px;letter-spacing:.07em;text-transform:uppercase;color:var(--dim);font-weight:600}
.m .a{font-family:var(--mono);font-size:16px;margin-top:3px;font-variant-numeric:tabular-nums}
.m .b{font-family:var(--mono);font-size:11px;color:var(--dim2);margin-top:1px}

/* annunciator */
.tiles{display:grid;grid-template-columns:repeat(auto-fill,minmax(132px,1fr));gap:6px;padding:8px 16px 14px}
.tile{background:#10161d;border:1px solid var(--line);border-radius:6px;padding:8px 9px;
  font-size:10.5px;font-weight:600;letter-spacing:.03em;color:#3d4855;min-height:38px;
  display:flex;align-items:center;line-height:1.25;transition:all .12s}
.tile.on{background:rgba(210,153,34,.16);border-color:rgba(210,153,34,.5);color:var(--warn)}
.tile.on.bad{background:rgba(248,81,73,.16);border-color:rgba(248,81,73,.5);color:var(--bad)}
.tile.on.ok{background:rgba(63,185,80,.14);border-color:rgba(63,185,80,.45);color:var(--good)}
.tile.new{animation:bl .6s steps(1,end) infinite}
.tile.first{outline:2px solid var(--bad);outline-offset:1px}
@keyframes bl{50%{opacity:.25}}
@media(prefers-reduced-motion:reduce){.tile.new{animation:none}}

/* trends */
#trends{width:100%;height:250px;display:block;padding:0}

/* controls */
.ctrls{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:12px}
.cg{padding:6px 16px 14px}
.field{margin-top:11px}
.field label{display:flex;justify-content:space-between;font-size:11.5px;color:var(--dim);margin-bottom:6px}
.field label b{font-family:var(--mono);color:var(--ink);font-weight:500}
input[type=range]{-webkit-appearance:none;appearance:none;width:100%;height:18px;background:transparent;cursor:pointer;margin:0}
input[type=range]::-webkit-slider-runnable-track{height:5px;background:#0b1017;border-radius:3px}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:15px;height:15px;margin-top:-5px;
  background:var(--accent);border-radius:50%;border:2px solid var(--surface)}
input[type=range]::-moz-range-track{height:5px;background:#0b1017;border-radius:3px}
input[type=range]::-moz-range-thumb{width:15px;height:15px;background:var(--accent);border-radius:50%;border:2px solid var(--surface)}
input[type=range]:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
.btns{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:11px}
button{background:var(--surface2);border:1px solid var(--line);color:var(--ink);cursor:pointer;
  padding:9px 8px;border-radius:7px;font-family:var(--sans);font-size:12px;font-weight:500;
  transition:all .12s}
button:hover{background:#242e3a;border-color:#31404f}
button:active{transform:translateY(1px)}
button.wide{grid-column:1/-1}
button.bad{color:var(--bad);border-color:rgba(248,81,73,.3)}
button.bad:hover{background:rgba(248,81,73,.12)}
button.good{color:var(--good);border-color:rgba(63,185,80,.3)}
button.good:hover{background:rgba(63,185,80,.12)}
button[aria-pressed=true]{background:var(--accent);color:#04121f;border-color:var(--accent)}
button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.seg{display:grid;grid-auto-flow:column;gap:6px;margin-top:11px}
.note{color:var(--dim2);font-size:11.5px;line-height:1.6;padding:0 16px 14px}
.note b{color:var(--dim)}
footer{color:var(--dim2);font-size:11px;text-align:center;padding:4px 0 12px;font-family:var(--mono)}
#loading{position:fixed;inset:0;background:var(--bg);display:flex;align-items:center;justify-content:center;
  color:var(--dim);font-size:14px;z-index:50}
</style>
</head>
<body>
<div id="loading">Initialising plant model…</div>
<div class="wrap" id="app" style="visibility:hidden">

<header>
  <div class="card title">
    <h1>Unit 1 &middot; Westinghouse 3-Loop PWR</h1>
    <p id="sub">2775 MWt &middot; 916 MWe gross &middot; 157 assemblies &middot; mid-cycle</p>
  </div>
  <div class="kpis">
    <div class="kpi"><div class="l">Reactor</div><div class="v" id="kPow">—</div><div class="u">% RATED</div></div>
    <div class="kpi"><div class="l">Tavg</div><div class="v" id="kTavg">—</div><div class="u" id="kTref">°F</div></div>
    <div class="kpi"><div class="l">RCS press</div><div class="v" id="kP">—</div><div class="u">PSIG</div></div>
    <div class="kpi"><div class="l">Generator</div><div class="v" id="kMW">—</div><div class="u">MWe NET</div></div>
  </div>
</header>

<div id="banner"></div>

<div class="grid">
  <div class="card">
    <h2>Reactor</h2>
    <div class="rows" id="rCore"></div>
  </div>
  <div class="card">
    <h2>Reactor coolant system</h2>
    <div class="rows" id="rRCS"></div>
  </div>
  <div class="card">
    <h2>Steam &amp; feedwater</h2>
    <div class="rows" id="rSec"></div>
  </div>
  <div class="card">
    <h2>Electrical</h2>
    <div class="rows" id="rElec"></div>
  </div>
</div>

<div class="grid" style="grid-template-columns:1fr 1fr">
  <div class="card">
    <h2>Loops — Thot / Tcold / flow</h2>
    <div class="mini" id="mLoops"></div>
  </div>
  <div class="card">
    <h2>Steam generators — level / pressure</h2>
    <div class="mini" id="mSGs"></div>
  </div>
</div>

<div class="card">
  <h2>Annunciator <span style="color:var(--dim2);font-weight:400;text-transform:none;letter-spacing:0"> — first-out outlined in red</span></h2>
  <div class="tiles" id="tiles"></div>
</div>

<div class="card">
  <h2>Trends — 10 minutes</h2>
  <canvas id="trends"></canvas>
</div>

<div class="ctrls">
  <div class="card cg">
    <h2 style="padding-left:0">Load</h2>
    <div class="field">
      <label>Turbine load setpoint <b id="oLoad">100%</b></label>
      <input type="range" id="sLoad" min="0" max="100" step="1" value="100">
    </div>
    <div class="field">
      <label>Ramp rate <b id="oRamp">5 %/min</b></label>
      <input type="range" id="sRamp" min="1" max="20" step="1" value="5">
    </div>
  </div>

  <div class="card cg">
    <h2 style="padding-left:0">Reactivity</h2>
    <div class="seg">
      <button id="bRodAuto" aria-pressed="true">Rods auto</button>
      <button id="bRodMan" aria-pressed="false">Manual</button>
    </div>
    <div class="btns">
      <button id="bRodOut">Withdraw ▲</button>
      <button id="bRodIn">Insert ▼</button>
      <button id="bDilute">Dilute −5 ppm</button>
      <button id="bBorate">Borate +5 ppm</button>
    </div>
  </div>

  <div class="card cg">
    <h2 style="padding-left:0">Events</h2>
    <div class="btns">
      <button class="bad" id="bScram">Reactor trip</button>
      <button class="bad" id="bTurb">Turbine trip</button>
      <button class="bad" id="bLOOP">Loss of offsite</button>
      <button class="bad" id="bLOFW">Loss of feedwater</button>
      <button class="bad" id="bRCP">Trip one RCP</button>
      <button class="bad" id="bPORV">PORV sticks open</button>
    </div>
  </div>

  <div class="card cg">
    <h2 style="padding-left:0">Simulation</h2>
    <div class="seg">
      <button id="bSpeed1" aria-pressed="true">1×</button>
      <button id="bSpeed10" aria-pressed="false">10×</button>
      <button id="bSpeed60" aria-pressed="false">60×</button>
      <button id="bSpeedAuto" aria-pressed="false">Auto</button>
    </div>
    <div class="btns">
      <button id="bPause">Pause</button>
      <button id="bAck">Acknowledge</button>
      <button class="good wide" id="bReset">Reset to 100% power</button>
    </div>
    <div style="margin-top:10px;font-size:11.5px;color:var(--dim2);font-family:var(--mono)" id="oSpeed">1× · t = 0 s</div>
  </div>
</div>

<div class="card"><div class="note" id="modelnote"></div></div>
<footer>Physics modules validated independently &middot; no build step &middot; runs from any static host</footer>
</div>

<script type="module">
import * as PLANT from './lib/plant.js';
import * as EL from './lib/elec.js';
import * as Z from './lib/pzr.js';

const $ = id => document.getElementById(id);
const F = (x, n = 1) => Number.isFinite(x) ? x.toFixed(n) : '—';
const clamp = (v,a,b)=>Math.max(a,Math.min(b,v));

// ---------------------------------------------------------------- model
let PL = PLANT.makePlant({ life: 'MOL' });
PLANT.initPlant(PL, 1.0, 900);
PL.rodAuto = true;

let paused = false, speed = 1, autoSpeed = false, simT = 0;

// ---------------------------------------------------------------- trends
const TR = { n: 1200, i: 0, full: false, keys: ['pow','tavg','tref','p','lvl','sg','mwe'] };
for (const k of TR.keys) TR[k] = new Float32Array(TR.n);
TR.t = new Float32Array(TR.n);
function pushTrend(s){
  const i = TR.i;
  TR.t[i]=simT; TR.pow[i]=s.power; TR.tavg[i]=s.Tavg; TR.tref[i]=s.Tref;
  TR.p[i]=s.Ppzr; TR.lvl[i]=s.pzrLvl; TR.sg[i]=s.sgLvl[0]; TR.mwe[i]=s.netMWe;
  TR.i=(i+1)%TR.n; if(TR.i===0) TR.full=true;
}
function series(k){
  const out=[], n = TR.full?TR.n:TR.i;
  for(let j=0;j<n;j++){ const idx = TR.full?(TR.i+j)%TR.n:j; out.push([TR.t[idx],TR[k][idx]]); }
  return out;
}

// ---------------------------------------------------------------- alarms
const ALARMS = [
  ['REACTOR TRIP',        p=>p.trip, 'bad'],
  ['TURBINE TRIP',        p=>p.sec.tripped, 'bad'],
  ['HIGH FLUX',           p=>p.k.P>1.08, ''],
  ['OT ΔT',               p=>p.f.otdtTrip, 'bad'],
  ['OP ΔT',               p=>p.f.opdtTrip, 'bad'],
  ['Tavg DEVIATION',      p=>Math.abs(p.S.Tavg-p.Tref)>4, ''],
  ['PZR PRESS HIGH',      p=>p.S.P-14.7>p.zp.pHiAlarm, ''],
  ['PZR PRESS LOW',       p=>p.S.P-14.7<p.zp.pLoAlarm, ''],
  ['PZR LEVEL HIGH',      p=>p.S.pzrLevel*100>70, ''],
  ['PZR LEVEL LOW',       p=>p.S.pzrLevel*100<25, ''],
  ['PZR PORV OPEN',       p=>p.z.porvOpen.some(Boolean), 'bad'],
  ['LOW SUBCOOLING',      p=>p.S.subcooling<25, 'bad'],
  ['RCS VOID',            p=>p.S.voidMax>0.01, 'bad'],
  ['LOW RCS FLOW',        p=>p.S.W.some(w=>w<0.9*p.rp.Wrated), ''],
  ['RCP TRIPPED',         p=>p.E.rcpOn.some(x=>!x), ''],
  ['SG LEVEL LO-LO',      p=>p.sgs.some(s=>s.lvlNR<p.sp.lvlLoLo), 'bad'],
  ['SG LEVEL LOW',        p=>p.sgs.some(s=>s.lvlNR<p.sp.lvlLo), ''],
  ['SG LEVEL HIGH',       p=>p.sgs.some(s=>s.lvlNR>p.sp.lvlHi), ''],
  ['SG SAFETY OPEN',      p=>p.sgs.some(s=>s.nSafetyOpen>0), 'bad'],
  ['STEAM DUMPS OPEN',    p=>p.sec.dumpPos>0.02, ''],
  ['AFW ACTUATED',        p=>p.sec.afwOn, ''],
  ['LOSS OF OFFSITE',     p=>!p.E.gridAvail, 'bad'],
  ['GENERATOR TRIP',      p=>p.E.tripped, 'bad'],
  ['SAFETY BUS ON DG',    p=>p.E.safetyFrom.some(s=>s==='edg'), ''],
  ['DG RUNNING',          p=>p.E.edg.some(e=>e.running), 'ok'],
  ['DG FAILED',           p=>p.E.edg.some(e=>e.tripped), 'bad']
];
const aState = ALARMS.map(()=>({on:false,ack:false,seq:0}));
let alarmSeq = 0, firstOut = -1;

function buildTiles(){
  $('tiles').innerHTML = ALARMS.map(a=>`<div class="tile">${a[0]}</div>`).join('');
}
function updAlarms(){
  const els = $('tiles').children;
  let anyNew = false;
  for(let i=0;i<ALARMS.length;i++){
    let on=false; try{ on = !!ALARMS[i][1](PL); }catch(e){}
    const st = aState[i], el = els[i];
    if(on && !st.on){ st.ack=false; st.seq=++alarmSeq;
      if(firstOut<0) firstOut=i; }
    if(!on && st.on) st.seq=0;
    st.on=on;
    if(on && !st.ack) anyNew=true;
    el.className='tile'+(on?' on':'')+(ALARMS[i][2]?' '+ALARMS[i][2]:'')
      +(on&&!st.ack?' new':'')+(on&&i===firstOut?' first':'');
  }
  if(!aState.some(a=>a.on)) firstOut=-1;
  return anyNew;
}

// ---------------------------------------------------------------- readouts
function rows(el, list){
  el.innerHTML = list.map(([k,v,cls])=>
    `<div class="row"><span class="k">${k}</span><span class="v ${cls||''}">${v}</span></div>`).join('');
}
function cls(v, lo, hi){ return v<lo||v>hi ? 'bad' : ''; }

function render(){
  const s = PLANT.snapshot(PL), S=PL.S, E=PL.E, sec=PL.sec, sgs=PL.sgs;

  $('kPow').textContent = F(s.power,1);
  $('kPow').className = 'v ' + (s.power>102?'bad':'');
  $('kTavg').textContent = F(s.Tavg,1);
  $('kTref').textContent = '°F · REF ' + F(s.Tref,1);
  $('kTavg').className = 'v ' + (Math.abs(s.Tavg-s.Tref)>4?'warn':'');
  $('kP').textContent = F(s.Ppzr,0);
  $('kP').className = 'v ' + cls(s.Ppzr,2000,2350);
  $('kMW').textContent = F(s.netMWe,0);

  const b=$('banner');
  if(PL.trip){ b.className='on'; b.innerHTML=`REACTOR TRIP — ${PL.tripFirst}<span>first-out latched · decay heat ${F(PL.k.Pdecay*100,2)}% · subcooling ${F(S.subcooling,0)} °F</span>`; }
  else b.className='';

  rows($('rCore'), [
    ['Neutron flux', F(PL.k.P*100,2)+' %'],
    ['Total thermal', F(s.power,2)+' %'],
    ['Decay heat', F(PL.k.Pdecay*100,2)+' %'],
    ['Reactor period', PL.k.period===Infinity||Math.abs(PL.k.period)>1e4?'∞':F(PL.k.period,0)+' s'],
    ['Control bank D', F(PL.banks.ctrlDemand,0)+' steps'],
    ['Boron', F(PL.ppm,0)+' ppm'],
    ['Xenon worth', F(PL.rx.xeEqWorth*PL.fp.X,0)+' pcm'],
    ['Avg fuel temp', F(PL.f.Tf,0)+' °F'],
    ['DNBR', F(PL.dnbr??0,2), (PL.dnbr??9)<1.5?'bad':'good']
  ]);

  rows($('rRCS'), [
    ['Pressure', F(s.Ppzr,0)+' psig', cls(s.Ppzr,2000,2350)],
    ['PZR level', F(s.pzrLvl,1)+' %', cls(s.pzrLvl,20,75)],
    ['PZR heaters', F(PL.z.heaterKW,0)+' kW'],
    ['PZR spray', F(PL.z.sprayGpm,0)+' gpm'],
    ['Subcooling', F(S.subcooling,0)+' °F', S.subcooling<25?'bad':'good'],
    ['Max void', F(S.voidMax,3), S.voidMax>0.005?'bad':'dimv'],
    ['Thot / Tcold', F(S.Thot[0],1)+' / '+F(S.Tcold[0],1)],
    ['Core ΔT', F(S.Thot[0]-S.Tcold[0],1)+' °F'],
    ['Total flow', F(S.W.reduce((a,b)=>a+b,0)/PL.rp.Wrated/3*100,1)+' %']
  ]);

  rows($('rSec'), [
    ['Steam pressure', F(sgs[0].Psec,0)+' psia'],
    ['Steam flow', F(sec.Wturb/1e6,2)+'e6 lb/hr'],
    ['Feed flow', F(sec.WfwTotal/1e6,2)+'e6 lb/hr'],
    ['Feedwater temp', F(sec.TfwF,0)+' °F'],
    ['Turbine valves', F(sec.valvePos*100,0)+' %'],
    ['Steam dumps', F(sec.dumpPos*100,0)+' %', sec.dumpPos>0.02?'warn':'dimv'],
    ['Gross output', F(sec.MWe,0)+' MWe'],
    ['AFW', sec.afwOn?'RUNNING':'standby', sec.afwOn?'warn':'dimv'],
    ['Riser void', F(sgs[0].alphaRiser,3)]
  ]);

  rows($('rElec'), [
    ['Generator', E.tripped?'TRIPPED':(E.genBkr?'ON LINE':'off line'), E.tripped?'bad':'good'],
    ['Gross', F(E.MWe,0)+' MWe'],
    ['Reactive', F(E.MVAr,0)+' MVAr'],
    ['Power factor', F(E.pf,3)+(E.lead?' lead':' lag')],
    ['House load', F(E.houseMW,1)+' MW'],
    ['Net to grid', F(E.netMWe,0)+' MWe'],
    ['Aux source', (E.auxSource||'none').toUpperCase(), E.auxSource==='none'?'bad':''],
    ['4.16 kV bus 1A', F(E.Vsafety[0],2)+' pu · '+E.safetyFrom[0].toUpperCase(),
      E.Vsafety[0]<0.9?'bad':'good'],
    ['RCPs running', E.rcpOn.filter(Boolean).length+' of 3',
      E.rcpOn.filter(Boolean).length<3?'bad':'good']
  ]);

  $('mLoops').innerHTML = [0,1,2].map(i=>
    `<div class="m"><div class="t">Loop ${'ABC'[i]}</div>
     <div class="a">${F(S.Thot[i],1)}</div>
     <div class="b">cold ${F(S.Tcold[i],1)} °F</div>
     <div class="b">flow ${F(S.W[i]/PL.rp.Wrated*100,1)} %</div>
     <div class="bar"><i class="${S.W[i]<0.9*PL.rp.Wrated?'bad':'good'}" style="width:${clamp(S.W[i]/PL.rp.Wrated*100,0,100)}%"></i></div></div>`).join('');

  $('mSGs').innerHTML = [0,1,2].map(i=>{
    const g=sgs[i], bad=g.lvlNR<PL.sp.lvlLoLo, warn=g.lvlNR<PL.sp.lvlLo||g.lvlNR>PL.sp.lvlHi;
    return `<div class="m"><div class="t">SG ${'ABC'[i]}</div>
     <div class="a">${F(g.lvlNR,1)}<span style="font-size:11px;color:var(--dim2)"> %</span></div>
     <div class="b">${F(g.Psec,0)} psia</div>
     <div class="b">feed ${F(sec.Wfw[i]/1e6,2)}e6</div>
     <div class="bar"><i class="${bad?'bad':(warn?'warn':'good')}" style="width:${clamp(g.lvlNR,0,100)}%"></i></div></div>`;
  }).join('');

  const anyNew = updAlarms();
  if(autoSpeed && anyNew && speed>1) setSpeed(1);
  drawTrends();
  $('oSpeed').textContent = `${autoSpeed?'auto':speed+'×'} · t = ${F(simT,0)} s${paused?' · PAUSED':''}`;
}

// ---------------------------------------------------------------- trends
function drawTrends(){
  const cv=$('trends'), r=cv.getBoundingClientRect();
  const dpr=Math.min(2,window.devicePixelRatio||1);
  const w=Math.max(2,Math.round(r.width)), h=Math.max(2,Math.round(r.height));
  if(cv.width!==w*dpr||cv.height!==h*dpr){cv.width=w*dpr;cv.height=h*dpr;}
  const x=cv.getContext('2d'); x.setTransform(dpr,0,0,dpr,0,0); x.clearRect(0,0,w,h);
  const t1=simT, t0=Math.max(0,t1-600);
  const panes=[
    {yr:[0,110], lbl:'power % / SG level %', ser:[['pow','#4a9eff','power'],['sg','#a371f7','SG lvl'],['lvl','#39c5cf','PZR lvl']]},
    {yr:[520,600], lbl:'°F', ser:[['tavg','#3fb950','Tavg'],['tref','#8b98a5','Tref']]},
    {yr:[1400,2500], lbl:'psig / MWe', ser:[['p','#d29922','PZR press'],['mwe','#f85149','net MWe']]}
  ];
  const ph=(h-6)/3;
  panes.forEach((pn,pi)=>{
    const T=pi*ph+8, B=(pi+1)*ph-4, L=54, R=w-96;
    x.strokeStyle='rgba(255,255,255,.05)'; x.lineWidth=1;
    for(let i=0;i<=3;i++){const y=B-(B-T)*i/3; x.beginPath();x.moveTo(L,y);x.lineTo(R,y);x.stroke();}
    x.font='10px JetBrains Mono, monospace'; x.fillStyle='#5e6b7a'; x.textAlign='right';
    for(let i=0;i<=3;i++){const y=B-(B-T)*i/3, v=pn.yr[0]+(pn.yr[1]-pn.yr[0])*i/3;
      x.fillText(v>=1000?v.toFixed(0):v.toFixed(0),L-7,y+3);}
    const X=v=>L+(R-L)*(v-t0)/Math.max(t1-t0,1);
    const Y=v=>B-(B-T)*(clamp(v,pn.yr[0],pn.yr[1])-pn.yr[0])/(pn.yr[1]-pn.yr[0]);
    pn.ser.forEach((sd,si)=>{
      const d=series(sd[0]); if(d.length<2) return;
      x.beginPath(); let started=false;
      for(const [tt,vv] of d){ if(tt<t0) continue;
        const px=X(tt), py=Y(vv);
        started?x.lineTo(px,py):(x.moveTo(px,py),started=true); }
      x.strokeStyle=sd[1]; x.lineWidth=1.6; x.stroke();
      x.fillStyle=sd[1]; x.textAlign='left'; x.font='10px JetBrains Mono, monospace';
      x.fillText(sd[2],R+8,T+12+si*13);
    });
  });
}

// ---------------------------------------------------------------- controls
function setSpeed(v){ speed=v; autoSpeed=false;
  for(const [id,val] of [['bSpeed1',1],['bSpeed10',10],['bSpeed60',60]])
    $(id).setAttribute('aria-pressed', String(val===v));
  $('bSpeedAuto').setAttribute('aria-pressed','false');
}
$('bSpeed1').onclick=()=>setSpeed(1);
$('bSpeed10').onclick=()=>setSpeed(10);
$('bSpeed60').onclick=()=>setSpeed(60);
$('bSpeedAuto').onclick=()=>{ autoSpeed=true; speed=60;
  ['bSpeed1','bSpeed10','bSpeed60'].forEach(i=>$(i).setAttribute('aria-pressed','false'));
  $('bSpeedAuto').setAttribute('aria-pressed','true'); };

$('sLoad').oninput=e=>{ const v=+e.target.value; PL.sec.loadSet=v/100; $('oLoad').textContent=v+'%'; };
$('sRamp').oninput=e=>{ const v=+e.target.value; PL.sc.rampPctPerMin=v; $('oRamp').textContent=v+' %/min'; };

$('bRodAuto').onclick=()=>{PL.rodAuto=true;$('bRodAuto').setAttribute('aria-pressed','true');$('bRodMan').setAttribute('aria-pressed','false');};
$('bRodMan').onclick=()=>{PL.rodAuto=false;$('bRodAuto').setAttribute('aria-pressed','false');$('bRodMan').setAttribute('aria-pressed','true');};
function hold(id,fn){ let t=null;
  const go=e=>{e.preventDefault();fn();clearInterval(t);t=setInterval(fn,90);};
  const stop=()=>{clearInterval(t);t=null;};
  const el=$(id); el.addEventListener('mousedown',go); el.addEventListener('touchstart',go,{passive:false});
  ['mouseup','mouseleave','touchend','touchcancel'].forEach(ev=>el.addEventListener(ev,stop)); }
hold('bRodOut',()=>{PL.banks.ctrlDemand=clamp(PL.banks.ctrlDemand+2,0,528);});
hold('bRodIn', ()=>{PL.banks.ctrlDemand=clamp(PL.banks.ctrlDemand-2,0,528);});
$('bDilute').onclick=()=>{PL.ppm=Math.max(0,PL.ppm-5);};
$('bBorate').onclick=()=>{PL.ppm+=5;};

$('bScram').onclick=()=>{ PL.trip=true; PL.tripMsg='MANUAL TRIP'; if(!PL.tripFirst)PL.tripFirst='MANUAL TRIP';
  PL.sec.tripped=true; EL.tripGenerator(PL.E,'UNIT TRIP'); PL.banks.ctrlDemand=0; PL.banks.sd=[0,0]; };
$('bTurb').onclick=()=>{ PL.sec.tripped=true; };
$('bLOOP').onclick=()=>{ EL.loseOffsite(PL.E); EL.tripGenerator(PL.E,'LOOP'); };
$('bLOFW').onclick=()=>{ PL.sec.mfpOn=[false,false]; };
$('bRCP').onclick=()=>{ PL.E.rcpOn[1]=false; PL.S.pumpOn[1]=false; };
$('bPORV').onclick=()=>{ PL.z.porvStuck[0]=true; };
$('bPause').onclick=()=>{ paused=!paused; $('bPause').textContent=paused?'Run':'Pause'; };
$('bAck').onclick=()=>aState.forEach(a=>a.ack=true);
$('bReset').onclick=()=>{
  PL=PLANT.makePlant({life:'MOL'}); PLANT.initPlant(PL,1.0,900); PL.rodAuto=true;
  simT=0; TR.i=0; TR.full=false; firstOut=-1; alarmSeq=0;
  aState.forEach(a=>{a.on=false;a.ack=false;});
  $('sLoad').value=100; $('oLoad').textContent='100%';
  $('bPause').textContent='Pause'; paused=false;
};

$('modelnote').innerHTML =
 '<b>Model.</b> Six-group point kinetics with ANS-5.1 decay heat; reactivity from Doppler, '+
 'moderator density coupled to boron, rod banks with 128-step overlap, and xenon/samarium — '+
 'calibrated against the NRC Westinghouse Technology Systems Manual §2.1. Seventeen-volume RCS '+
 'with three independent loops, loop seals and a global pressure solve that covers water-solid, '+
 'bubble and voided states in one formulation. Steam generators carry riser void as a state, so '+
 'shrink and swell are real non-minimum-phase responses rather than lag. W-3 DNBR, the actual '+
 'OTΔT and OPΔT trip functions, and a plant electrical system in which the reactor coolant pumps '+
 'are loads — so losing the grid drops the primary onto natural circulation. '+
 '<b>Limits:</b> lumped-parameter, no axial nodes (so no axial flux difference), no RHR or '+
 'safety injection yet, and it is not a substitute for a licensed simulator.';

// ---------------------------------------------------------------- loop
buildTiles();
let last=performance.now(), acc=0, tAcc=0;
function frame(now){
  const dtReal=clamp((now-last)/1000,0,0.25); last=now;
  if(!paused){
    const target=dtReal*speed;
    acc+=target;
    const dt=0.05; let n=0;
    while(acc>=dt && n<Math.max(40,speed*25)){ PLANT.stepPlant(PL,dt); simT+=dt; acc-=dt; n++; }
    if(acc>1) acc=0;
    tAcc+=dtReal;
    if(tAcc>0.25){ pushTrend(PLANT.snapshot(PL)); tAcc=0; }
  }
  render();
  requestAnimationFrame(frame);
}
$('loading').style.display='none';
$('app').style.visibility='visible';
requestAnimationFrame(frame);
</script>
